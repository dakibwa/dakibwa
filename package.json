{
  "name": "dakibwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-vite.mjs",
    "build": "node scripts/run-vite.mjs build",
    "preview": "node scripts/run-vite.mjs preview",
    "cloudflare:build": "python3 local-dashboard/launch.py --export-cloudflare ./cloudflare-dist",
    "cloudflare:deploy": "npm run cloudflare:build && npx wrangler pages deploy ./cloudflare-dist --project-name akibwa-life-private",
    "location:update": "node scripts/update-owner-location.mjs",
    "location:publish": "node scripts/update-owner-location.mjs --commit --push"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
