{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "akibwa-site",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "preview_urls": true,
  // The Cloudflare dashboard owns the akibwa.com Custom Domain. Omit route and
  // routes so asset deployments never change it or the existing API routes.
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
