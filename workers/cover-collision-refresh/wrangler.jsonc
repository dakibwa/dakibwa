{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "akibwa-cover-collision-refresh",
  "main": "src/index.js",
  "compatibility_date": "2026-06-04",
  "workers_dev": true,
  "triggers": {
    "crons": ["42 6 * * *"]
  },
  "vars": {
    "PUBLIC_SEED_URL": "https://raw.githubusercontent.com/dakibwa/dakibwa/main/data/cover-collision-data.json",
    "INSTAGRAM_USERNAME": "dakibwa"
  },
  "kv_namespaces": [
    {
      "binding": "COVER_COLLISION_KV",
      "id": "bffb131d602e43dfa5df5cfccfe1ef49"
    }
  ],
  "observability": {
    "enabled": true
  }
}
