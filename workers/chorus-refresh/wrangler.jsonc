{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "akibwa-chorus-refresh",
  "main": "src/index.js",
  "compatibility_date": "2026-06-04",
  "workers_dev": true,
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    "PUBLIC_SEED_URL": "https://raw.githubusercontent.com/dakibwa/dakibwa/main/data/chorus-data.json",
    "LASTFM_USERNAME": "akibwa"
  },
  "kv_namespaces": [
    {
      "binding": "CHORUS_KV",
      "id": "8bafd1b2d9754abc9b024245d3366ae4"
    }
  ],
  "observability": {
    "enabled": true
  }
}
